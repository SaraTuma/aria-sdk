{
  "name": "@aria-iam/core",
  "version": "1.0.9",
  "description": "ARIA authentication core — framework-agnostic TypeScript SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import":  { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts",  "default": "./dist/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.pt.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "echo \"no test\" && exit 1"
  },
  "keywords": [
    "iam",
    "auth",
    "authentication",
    "jwt",
    "sso",
    "typescript"
  ],
  "author": {
    "name": "Sara David Tuma",
    "url": "https://github.com/SaraTuma"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaraTuma/aria-sdk.git",
    "directory": "core"
  },
  "homepage": "https://github.com/SaraTuma/aria-sdk#readme",
  "bugs": {
    "url": "https://github.com/SaraTuma/aria-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "@types/js-cookie": "^3.0.6",
    "typescript": ">=5.0.0"
  }
}
